            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "tools.ozone.team.listMembers",
  "lexicon": 1
