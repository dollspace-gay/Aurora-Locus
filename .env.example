# Aurora Locus - Personal Data Server Configuration

# Service Configuration
PDS_HOSTNAME=localhost
PDS_PORT=2583
PDS_SERVICE_DID=did:web:localhost
PDS_VERSION=0.1.0

# Data Storage
PDS_DATA_DIRECTORY=./data
PDS_ACCOUNT_DB_LOCATION=./data/account.sqlite
PDS_SEQUENCER_DB_LOCATION=./data/sequencer.sqlite
PDS_DID_CACHE_DB_LOCATION=./data/did_cache.sqlite
PDS_ACTOR_STORE_DIRECTORY=./data/actors

# Database — defaults to SQLite for development; configure Postgres for
# production. Per-actor ActorStore is always SQLite regardless of
# backend; this only controls account_db and did_cache_db. Postgres
# wiring lands in chainlink #76 (Phase 3); until then setting
# PDS_DB_BACKEND=postgres rejects at startup with a clear error.
#
#PDS_DB_BACKEND=sqlite                    # sqlite or postgres
#PDS_DB_URL=                              # SQLite file path or postgres:// URL
#PDS_DB_MAX_CONNECTIONS=25                # pool ceiling
#PDS_DB_MIN_CONNECTIONS=5                 # pool floor
#PDS_DB_ACQUIRE_TIMEOUT_SECS=30           # checkout timeout
#PDS_DB_IDLE_TIMEOUT_SECS=                # idle reaping (optional)
#PDS_DB_MAX_LIFETIME_SECS=                # connection max lifetime (optional)

# Blob storage — configure EITHER disk OR S3, not both. Setting both
# PDS_BLOBSTORE_S3_BUCKET and PDS_BLOBSTORE_DISK_LOCATION rejects at
# config load. If neither is set, disk storage is used at the default
# location (PDS_DATA_DIRECTORY/blobs).
#
# Disk backend (development / hobbyist deployments):
PDS_BLOBSTORE_DISK_LOCATION=./data/blobs
PDS_BLOBSTORE_DISK_TMP_LOCATION=./data/temp
#
# S3 backend (production deployments — AWS S3, MinIO, DigitalOcean
# Spaces, Cloudflare R2, Backblaze B2, etc.):
# PDS_BLOBSTORE_S3_BUCKET=your-bucket-name
# PDS_BLOBSTORE_S3_REGION=us-east-1
# PDS_BLOBSTORE_S3_ENDPOINT=  # leave empty for AWS; set for non-AWS providers
# PDS_BLOBSTORE_S3_ACCESS_KEY_ID=your-access-key
# PDS_BLOBSTORE_S3_SECRET_ACCESS_KEY=your-secret-key
#
# Optional S3 knobs (sensible defaults if unset):
# PDS_BLOBSTORE_S3_FORCE_PATH_STYLE=false  # set to true for MinIO and providers without virtual-host-style addressing
# PDS_BLOBSTORE_S3_UPLOAD_TIMEOUT_MS=20000  # SDK operation timeout in milliseconds
# PDS_BLOBSTORE_S3_PREFIX=blobs/  # object key prefix (Aurora extension; useful for sharing a bucket across deployments)

# Authentication
PDS_JWT_SECRET=your-jwt-secret-here-change-in-production
PDS_ADMIN_PASSWORD=your-admin-password-here-change-in-production
PDS_REPO_SIGNING_KEY_K256_PRIVATE_KEY_HEX=generate-with-openssl
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=generate-with-openssl

# Identity
PDS_DID_PLC_URL=https://plc.directory
# Alternative: Use PLC_DIRECTORY_URL for runtime override (useful for testing/custom PLC directories)
# PLC_DIRECTORY_URL=https://test.plc.directory
PDS_SERVICE_HANDLE_DOMAINS=.localhost
PDS_DID_CACHE_STALE_TTL=3600
PDS_DID_CACHE_MAX_TTL=86400

# Email (optional)
# PDS_EMAIL_SMTP_URL=smtp://localhost:1025
# PDS_EMAIL_FROM_ADDRESS=noreply@localhost

# Invites
PDS_INVITE_REQUIRED=false
PDS_INVITE_INTERVAL=604800
PDS_INVITE_EPOCH=2024-01-01T00:00:00Z

# Rate Limiting
PDS_RATE_LIMITS_ENABLED=true
PDS_RATE_LIMIT_GLOBAL_REQUESTS_PER_MINUTE=3000

# Logging
RUST_LOG=info,aurora_locus=debug

# Upload Limits
PDS_BLOB_UPLOAD_LIMIT=5242880

# Federation Configuration
# Enable federation with the ATProto network
PDS_FEDERATION_ENABLED=false

# Relay server URLs (comma-separated for multiple relays)
# Default: https://bsky.network (official Bluesky relay)
PDS_FEDERATION_RELAY_URLS=https://bsky.network

# Enable firehose WebSocket endpoint for event streaming
# Allows relay servers to subscribe to your PDS events
PDS_FEDERATION_FIREHOSE_ENABLED=false

# Allow relay servers to crawl and sync your repositories
# Required for full federation participation
PDS_FEDERATION_CRAWL_ENABLED=false

# Public URL for this PDS (must be accessible from internet)
# Required for federation - other PDSs need to reach you
# Example: https://pds.example.com
PDS_PUBLIC_URL=http://localhost:2583

# Automatically stream events to relay servers
# When enabled, commits/identity/account events are published to relay
PDS_FEDERATION_AUTO_STREAM=false
